<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>cbfe9724-5608-4658-ba4f-fc35ddaed9cf</UserSecretsId>
  </PropertyGroup>
  <!--
    The Functions worker SDK generates a nested WorkerExtensions project under obj/, and
    that project's own build output adds roughly 120 more characters
    (bin/Release/net8.0/runtimes/win/lib/netstandard2.0/<assembly>.dll). On Windows without
    long-path support this pushes the total past MAX_PATH and the build fails with MSB3030
    ("could not copy ... because it was not found"). Relocate the generated project to a
    short path when the project directory is deep enough for that to be a risk.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(ExtensionsCsProjDirectory)' == '' And $(MSBuildProjectDirectory.Length) &gt; 60">
    <ExtensionsCsProjDirectory>$([System.IO.Path]::Combine($(LOCALAPPDATA), 'FuncWorkerExt', $(MSBuildProjectName), $(Configuration)))</ExtensionsCsProjDirectory>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json" Condition="Exists('local.settings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageReference Include="Azure.Data.Tables" Version="12.12.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.20.0" />
    <!--
      Stay on the 2.x line: Microsoft.Azure.Functions.Worker.ApplicationInsights below is built
      against Application Insights 2.23.0, and 3.x drops ITelemetryInitializer. Taking 3.x here
      wins the version conflict and the host dies at startup with a TypeLoadException for that
      type, which surfaces as "HTTP Error 500.30 - ASP.NET Core app failed to start".
    -->
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Blobs" Version="6.8.2" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="8.6.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
  </ItemGroup>
</Project>
